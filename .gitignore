# ---------------------------------------------------------------------------
# Unity 6 (project root = repo root)
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity temp / cache folders
.utmp/
.gradle/
ExportedObj/
.consulo/

# Autogenerated VS/MD/Consulo solution and project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.x86_64
*.x86

# Crashlytics generated file
crashlytics-build.properties

# Addressables / packed assets
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Burst debug information
/[Ll]ibrary/*_BurstDebugInformation_DoNotShip/
*_BurstDebugInformation_DoNotShip/

# ---------------------------------------------------------------------------
# IDEs / editors
# ---------------------------------------------------------------------------
.vs/
.idea/
*.sln.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Tools / local
# ---------------------------------------------------------------------------
*.log
.claude/settings.local.json
.env
.env.*

# Big splat files stay out of git (regenerate with Tools/decimate_splat.py)
Assets/_Project/Splats/scene_hall_*
Assets/Gaussians/3D/scene_hall_*
scene.ply
# Splat assets generated by the package are large and machine specific; recreate them (see PROJECT_NOTES.md)
Assets/Gaussians/
Assets/Gaussians.meta
Assets/_Recovery/
Assets/_Recovery.meta
Assets/_Project/Splats/parts/
Assets/_Project/Splats/parts.meta

# ---------------------------------------------------------------------------
# Archived Unity project: same rules, one folder deeper
# ---------------------------------------------------------------------------
unity-archive/[Ll]ibrary/
unity-archive/[Tt]emp/
unity-archive/[Oo]bj/
unity-archive/[Bb]uild/
unity-archive/[Bb]uilds/
unity-archive/[Ll]ogs/
unity-archive/[Uu]ser[Ss]ettings/
unity-archive/[Mm]emoryCaptures/
unity-archive/[Rr]ecordings/
unity-archive/[Aa]ssets/Plugins/Editor/JetBrains*
unity-archive/.utmp/
unity-archive/.gradle/
unity-archive/ExportedObj/
unity-archive/.consulo/
unity-archive/*.csproj
unity-archive/*.unityproj
unity-archive/*.sln
unity-archive/*.slnx
unity-archive/*.suo
unity-archive/*.tmp
unity-archive/*.user
unity-archive/*.userprefs
unity-archive/*.pidb
unity-archive/*.booproj
unity-archive/*.svd
unity-archive/*.pdb
unity-archive/*.mdb
unity-archive/*.opendb
unity-archive/*.VC.db
unity-archive/*.pidb.meta
unity-archive/*.pdb.meta
unity-archive/*.mdb.meta
unity-archive/sysinfo.txt
unity-archive/mono_crash.*
unity-archive/*.apk
unity-archive/*.aab
unity-archive/*.unitypackage
unity-archive/*.app
unity-archive/*.exe
unity-archive/*.x86_64
unity-archive/*.x86
unity-archive/crashlytics-build.properties
unity-archive/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
unity-archive/[Aa]ssets/[Ss]treamingAssets/aa.meta
unity-archive/[Aa]ssets/[Ss]treamingAssets/aa/*
unity-archive/[Ll]ibrary/*_BurstDebugInformation_DoNotShip/
unity-archive/*_BurstDebugInformation_DoNotShip/
unity-archive/.vs/
unity-archive/.idea/
unity-archive/*.sln.iml
unity-archive/.vscode/*
unity-archive/*.swp
unity-archive/*~
unity-archive/.DS_Store
unity-archive/.DS_Store?
unity-archive/._*
unity-archive/.Spotlight-V100
unity-archive/.Trashes
unity-archive/.AppleDouble
unity-archive/.LSOverride
unity-archive/Thumbs.db
unity-archive/ehthumbs.db
unity-archive/Desktop.ini
unity-archive/$RECYCLE.BIN/
unity-archive/*.log
unity-archive/.claude/settings.local.json
unity-archive/.env
unity-archive/.env.*
unity-archive/Assets/_Project/Splats/scene_hall_*
unity-archive/Assets/Gaussians/3D/scene_hall_*
unity-archive/scene.ply
unity-archive/Assets/Gaussians/
unity-archive/Assets/Gaussians.meta
unity-archive/Assets/_Recovery/
unity-archive/Assets/_Recovery.meta
unity-archive/Assets/_Project/Splats/parts/
unity-archive/Assets/_Project/Splats/parts.meta

# Web app
node_modules/
web/certs/
web/.env
web/.env.*
!web/.env.example
.DS_Store
