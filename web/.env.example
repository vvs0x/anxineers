# Local only. Never put this key in browser code or a VITE_ variable.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v2
# Optional: IDs from your ElevenLabs voice library. Blank uses three available voices.
ELEVENLABS_VOICE_CALM=
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=
ELEVENLABS_VOICE_C=
