  steps:
  - sense: 0
    count: 5
    prompt: Look around you. Name 5 things you can see.
    maxSeconds: 60
  - sense: 1
    count: 4
    prompt: Name 4 things you can feel or touch. You can reach out and touch objects
      near you.
    maxSeconds: 60
  - sense: 2
    count: 3
    prompt: Listen for a moment. Name 3 things you can hear.
    maxSeconds: 60
  - sense: 3
    count: 2
    prompt: Name 2 things you can smell, or 2 smells you like.
    maxSeconds: 60
  - sense: 4
    count: 1
    prompt: Name 1 thing you can taste, or a taste you like.
    maxSeconds: 60
  listenSeconds: 14
  intensityDropSpeed: 0.1
  startBreathingAtEnd: 1
