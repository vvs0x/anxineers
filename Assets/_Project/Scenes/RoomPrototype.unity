  m_Script: {fileID: 11500000, guid: 472763ab5e7024c34bb72c54d322743c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Anxineers.Session::Anxineers.Session.SessionController
  consentTitle: Before you begin
  consentBody: 'This is an educational VR experience. It gradually changes what you
    see and hear to show how anxiety can feel. It is not therapy or medical advice.


    You
    choose how strong it can get, and you can stop at any time with the A or X button.


    Your
    spoken answers may be sent briefly to an online service to understand them.'
  consentHint: Pull the trigger to agree and continue
  introTitle: What will happen
  introBody: 'You will stay where you are, seated or standing.


    The room will
    slowly change. After a while a short exercise helps you settle: you will name
    things you see, feel, hear, smell and taste, and then take a few slow breaths.'
  introHint: Pull the trigger to continue
  modeTitle: Choose an experience
  modeBody: Use the thumbstick (or the left and right arrow keys) to choose.
  modeHint: Pull the trigger to confirm
  educationLabel: Understand anxiety (for learning)
  regulationLabel: Practise settling (gentle)
  capTitle: Choose the maximum intensity
  capHint: You can always press A or X to calm down.
  endTitle: Finished
  endBody: Take a moment before you take off the headset.
  endHint: Pull the trigger to close
  maxSessionSeconds: 1200
  defaultCap: 0.5
  capStep: 0.1
  educationProfile: {fileID: 11400000, guid: 27a8f3cdfdef0474fbbc75f0073cb7b5, type: 2}
  regulationProfile: {fileID: 0}
  autoBegin: 1
  panel: {fileID: 0}
  grounding: {fileID: 0}
  breathing: {fileID: 0}
